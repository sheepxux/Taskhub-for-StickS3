#!/bin/bash
set -euo pipefail

LABEL="com.sticks3.taskhub"
CONSOLE_USER="$(stat -f '%Su' /dev/console)"
case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    echo "TaskHub Host requires a signed-in macOS user." >&2
    exit 1
    ;;
esac

USER_ID="$(id -u "$CONSOLE_USER")"
USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')"
APP_DIR="$USER_HOME/Library/Application Support/StickS3TaskHub"
PLIST="$USER_HOME/Library/LaunchAgents/$LABEL.plist"
TOKEN_FILE="$APP_DIR/token"

mkdir -p "$APP_DIR" "$USER_HOME/Library/LaunchAgents"
if [ ! -s "$TOKEN_FILE" ] || [ "$(cat "$TOKEN_FILE" 2>/dev/null || true)" = "dev-token" ]; then
  TOKEN="$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32 || true)"
  [ -n "$TOKEN" ] || {
    echo "Could not generate the TaskHub device token." >&2
    exit 1
  }
  umask 077
  printf '%s' "$TOKEN" > "$TOKEN_FILE"
fi
chmod 600 "$TOKEN_FILE"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/TaskHubHost/run_task_hub.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$APP_DIR</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$APP_DIR/task_hub.log</string>
  <key>StandardErrorPath</key>
  <string>$APP_DIR/task_hub.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>$USER_HOME</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
</dict>
</plist>
PLIST

chown -R "$CONSOLE_USER":staff "$APP_DIR"
chown "$CONSOLE_USER":staff "$PLIST"
launchctl bootout "gui/$USER_ID" "$PLIST" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$USER_ID" "$PLIST"
launchctl kickstart -k "gui/$USER_ID/$LABEL"

echo "TaskHub Host installed for $CONSOLE_USER."
echo "Open /Applications/TaskHub Host.app to pair a StickS3 or view diagnostics."

# Hand off to the pairing dialog in the user's session so the install ends
# with "type the code on your StickS3" instead of a silent finish.
launchctl asuser "$USER_ID" sudo -u "$CONSOLE_USER" /usr/bin/open "/Applications/TaskHub Host.app" >/dev/null 2>&1 || true
